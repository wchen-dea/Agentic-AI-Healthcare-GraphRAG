# Dev environment — local services, Ollama LLM
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=healthcare_events
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=healthcare123

LLM_PROVIDER=databricks
LLM_MODEL=quickstart_catalog.multi_agent_schema.model_routing_default_model
LLM_TIMEOUT_SECONDS=180
LLM_MAX_TOKENS=1200
LLM_TEMPERATURE=0.2
# Databricks workspace URL and a PAT/service-principal token for the AI Gateway
# serving endpoint above; set locally, do not commit real values.
DATABRICKS_HOST=change_me
DATABRICKS_TOKEN=change_me
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1

MCP_SERVER_NAME=HealthcareGraphRAG MCP (dev)
RAG_API_LANGGRAPH_ENABLED=true
LANGGRAPH_MAX_ITERATIONS=3
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=healthcare-graphrag-dev
RAG_API_ALLOW_ROLE_HEADER=true
RAG_API_ALLOW_ORIGINS=*
