# Base URL of the Healthcare RAG API. Use "/api" in dev to go through the Vite proxy.
VITE_API_BASE_URL=http://localhost:8000
# Dev-server proxy target for requests to /api (only used by `npm run dev`).
VITE_API_PROXY_TARGET=http://localhost:8000
# Client-side request timeout in milliseconds.
VITE_REQUEST_TIMEOUT_MS=120000
