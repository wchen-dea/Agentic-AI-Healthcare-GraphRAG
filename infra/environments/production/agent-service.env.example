# External managed services for production runtime
QDRANT_URL=https://qdrant.company.example
QDRANT_COLLECTION=healthcare_events
NEO4J_URI=neo4j+s://neo4j.company.example:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me

# LLM provider routing (recommended in production)
LLM_PROVIDER=bedrock
LLM_MODEL=anthropic.claude-3-5-haiku-20241022-v1:0
LLM_MODEL_SIMPLE=bedrock:anthropic.claude-3-5-haiku-20241022-v1:0
LLM_MODEL_MODERATE=bedrock:amazon.nova-pro-v1:0
LLM_MODEL_COMPLEX=bedrock:anthropic.claude-3-5-sonnet-20240620-v1:0
AWS_REGION=us-east-1
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=1200
LLM_TEMPERATURE=0.2
OPENAI_API_KEY=change_me

# Optional local fallback settings
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1

# Embedded MCP settings in agent-service process
MCP_SERVER_NAME=HealthcareGraphRAG MCP
# Tool policies ship inside the wheel (healthcare_agent/config/tool_policies.json).
# Override only with a mounted file, e.g. from a ConfigMap:
# AGENT_TOOL_POLICY_PATH=/etc/agent-service/tool_policies.json
AGENT_DEFAULT_CALLER_ROLE=generation
AGENT_ALLOW_ORIGINS=https://provider.company.example
AGENT_AUDIT_LOG_PATH=/var/log/agent-service/audit.log
AGENT_MAX_QUESTION_CHARS=1000
AGENT_MAX_CONTEXT_ITEMS=5
AGENT_MAX_EVIDENCE_CHARS=240
AGENT_MAX_ANSWER_CHARS=2000
AGENT_MAX_RESPONSE_BYTES=50000

# Multi-agent orchestration (LangGraph is the only query path)
LANGGRAPH_MAX_ITERATIONS=3

# Observability — MLflow tracing
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=healthcare-graphrag

# Security — disable role header trust in production
AGENT_ALLOW_ROLE_HEADER=false
