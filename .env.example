# Copy to .env. This file is the single value source for local docker compose.
# Each setting has exactly one variable name; provider-specific model aliases
# (OLLAMA_MODEL, DATABRICKS_MODEL, BEDROCK_MODEL_ID) are not read.

# --- Streaming ---
KAFKA_BOOTSTRAP_SERVERS=kafka:29092,kafka2:29093,kafka3:29094
SCHEMA_REGISTRY_URL=http://schema-registry:8081

# --- Stores ---
QDRANT_URL=http://qdrant:6333
# Governed patient memory: memory for ephemeral development, redis for shared persistence.
PATIENT_MEMORY_STORE_BACKEND=postgres
PATIENT_MEMORY_POSTGRES_DB=patient_memory
PATIENT_MEMORY_POSTGRES_USER=patient_memory
PATIENT_MEMORY_POSTGRES_PASSWORD=change_me
PATIENT_MEMORY_DATABASE_URL=postgresql://patient_memory:change_me@patient-memory-postgres:5432/patient_memory
REDIS_URL=redis://redis:6379/0
QDRANT_COLLECTION=healthcare_events
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me

# --- Platform UIs ---
CONDUKTOR_POSTGRES_PASSWORD=change_me
CONDUKTOR_ADMIN_PASSWORD=change_me
GRAFANA_ADMIN_PASSWORD=change_me

# --- LLM ---
# LLM_PROVIDER: databricks | ollama | bedrock | openai | anthropic
# LLM_MODEL is the model name / serving endpoint for the selected provider.
LLM_PROVIDER=databricks
LLM_MODEL=databricks-gpt-5-6-luna
# Reasoning models need a larger token budget and longer timeout.
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=300
# Optional per-tier overrides ("model" or "provider:model"); default to LLM_MODEL.
# LLM_MODEL_SIMPLE=
# LLM_MODEL_MODERATE=
# LLM_MODEL_COMPLEX=

# Databricks provider credentials (required when LLM_PROVIDER=databricks).
DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
DATABRICKS_TOKEN=change_me

# Ollama endpoint (used only when LLM_PROVIDER=ollama).
OLLAMA_URL=http://ollama:11434

# --- Embeddings ---
# Per-domain overrides EMBEDDING_MODEL_CLINICAL/CLAIMS/DEVICE are optional and
# default to EMBEDDING_MODEL. Flink ingest and agent queries must use the same
# model; changing it requires re-ingesting (recreating) the Qdrant collections.
# EMBEDDING_PROVIDER=local (dev) embeds in-process with EMBEDDING_MODEL
# (all-MiniLM-L6-v2, 384 dims, baked into the Flink and agent images).
# EMBEDDING_PROVIDER=databricks (prod) calls the Databricks Model Serving
# endpoint below using DATABRICKS_HOST/DATABRICKS_TOKEN; set EMBEDDING_DIM=1024
# for databricks-gte-large-en and re-ingest the Qdrant collections.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_DIM=1024
# DATABRICKS_EMBEDDING_ENDPOINT=databricks-gte-large-en
# Fail instead of silently falling back to MD5 hash vectors when the model
# cannot load. Set to false only for offline local unit runs.
EMBEDDING_REQUIRE_MODEL=true

# --- Observability ---
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=healthcare-graphrag

# --- Agent service (AGENT_ prefix) ---
# Tool policies ship inside the wheel; set this only to override with a mounted file.
# AGENT_TOOL_POLICY_PATH=/etc/agent-service/tool_policies.json
AGENT_DEFAULT_CALLER_ROLE=generation
AGENT_ALLOW_ORIGINS=http://localhost:8088
AGENT_AUDIT_LOG_PATH=./logs/agent_audit.log
AGENT_MAX_QUESTION_CHARS=1000
AGENT_MAX_CONTEXT_ITEMS=5
AGENT_MAX_EVIDENCE_CHARS=240
AGENT_MAX_ANSWER_CHARS=2000
AGENT_MAX_RESPONSE_BYTES=50000

# --- MCP server (shared agent_core.mcp_server factory) ---
# Empty MCP_INSTRUCTIONS uses the domain default instructions.
# MCP_INSTRUCTIONS=
MCP_STATELESS_HTTP=false
MCP_JSON_RESPONSE=false
# Enable DNS-rebinding protection outside local Docker; list every Host/Origin clients use.
MCP_DNS_REBINDING_PROTECTION=false
# MCP_ALLOWED_HOSTS=localhost:8000,agent-service:8000
# MCP_ALLOWED_ORIGINS=http://localhost:8088
